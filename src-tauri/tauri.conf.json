{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StandForge",
  "version": "0.1.0",
  "identifier": "com.standforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:11451",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StandForge",
        "label": "main",
        "width": 500,
        "height": 600,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "skipTaskbar": false
      },
      {
        "title": "StandForge Timer",
        "label": "floating",
        "width": 360,
        "height": 84,
        "resizable": false,
        "center": false,
        "x": 24,
        "y": 80,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
