{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StandForge",
  "version": "0.1.0",
  "identifier": "com.standforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StandForge Floating Timer",
        "label": "floating",
        "width": 340,
        "height": 80,
        "resizable": true,
        "center": false,
        "x": 24,
        "y": 80,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 40
        },
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": false,
        "visible": true,
        "focus": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
